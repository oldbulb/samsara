{
  "name": "@oldbulb/samsara-proposers",
  "version": "0.1.0",
  "description": "ctx.proposers: the registry of proposer adapters and the Proposal contract every adapter returns (claude-p, command, human)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/proposers"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./human": {
      "types": "./lib/types/human.d.ts",
      "default": "./lib/human.js"
    },
    "./claude-p": {
      "types": "./lib/types/claude-p.d.ts",
      "default": "./lib/claude-p.js"
    },
    "./command": {
      "types": "./lib/types/command.d.ts",
      "default": "./lib/command.js"
    },
    "./plugin-claude-p": {
      "types": "./lib/types/plugin-claude-p.d.ts",
      "default": "./lib/plugin-claude-p.js"
    },
    "./plugin-command": {
      "types": "./lib/types/plugin-command.d.ts",
      "default": "./lib/plugin-command.js"
    },
    "./plugin-human": {
      "types": "./lib/types/plugin-human.d.ts",
      "default": "./lib/plugin-human.js"
    }
  },
  "files": [
    "lib",
    "templates"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/proposers/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-kernel": "workspace:*",
    "@oldbulb/samsara-sandbox": "workspace:*",
    "ajv": "8.20.0"
  }
}
