{
  "name": "@samsara/runner",
  "version": "0.0.0",
  "private": true,
  "description": "samsara-runner: run one pack task set through one loop as champion attempts and write attempts.jsonl",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./round": {
      "types": "./lib/types/round.d.ts",
      "default": "./lib/round.js"
    },
    "./challenge": {
      "types": "./lib/types/challenge.d.ts",
      "default": "./lib/challenge.js"
    },
    "./certify": {
      "types": "./lib/types/certify.d.ts",
      "default": "./lib/certify.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/runner/tests"
  },
  "dependencies": {
    "@samsara/book": "workspace:*",
    "@samsara/champion": "workspace:*",
    "@samsara/gate": "workspace:*",
    "@samsara/kernel": "workspace:*",
    "@samsara/ledger": "workspace:*",
    "@samsara/loops": "workspace:*",
    "@samsara/pack": "workspace:*",
    "@samsara/proposers": "workspace:*",
    "@samsara/scope": "workspace:*",
    "@samsara/signoff": "workspace:*",
    "@samsara/submit": "workspace:*",
    "@samsara/workdir": "workspace:*"
  }
}
