{
  "name": "@oldbulb/samsara-runner",
  "version": "0.1.0",
  "description": "samsara-runner: run one pack task set through one loop as champion attempts and write attempts.jsonl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/runner"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./round": {
      "types": "./lib/types/round.d.ts",
      "default": "./lib/round.js"
    },
    "./challenge": {
      "types": "./lib/types/challenge.d.ts",
      "default": "./lib/challenge.js"
    },
    "./certify": {
      "types": "./lib/types/certify.d.ts",
      "default": "./lib/certify.js"
    },
    "./propose": {
      "types": "./lib/types/propose.d.ts",
      "default": "./lib/propose.js"
    },
    "./bench": {
      "types": "./lib/types/bench.d.ts",
      "default": "./lib/bench.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./gate-presets": {
      "types": "./lib/types/gate-presets.d.ts",
      "default": "./lib/gate-presets.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/runner/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-book": "workspace:*",
    "@oldbulb/samsara-champion": "workspace:*",
    "@oldbulb/samsara-environments": "workspace:*",
    "@oldbulb/samsara-gate": "workspace:*",
    "@oldbulb/samsara-gate-catalog": "workspace:*",
    "@oldbulb/samsara-kernel": "workspace:*",
    "@oldbulb/samsara-ledger": "workspace:*",
    "@oldbulb/samsara-lifecycle": "workspace:*",
    "@oldbulb/samsara-loops": "workspace:*",
    "@oldbulb/samsara-pack": "workspace:*",
    "@oldbulb/samsara-proposers": "workspace:*",
    "@oldbulb/samsara-sandbox": "workspace:*",
    "@oldbulb/samsara-scope": "workspace:*",
    "@oldbulb/samsara-signoff": "workspace:*",
    "@oldbulb/samsara-submit": "workspace:*",
    "@oldbulb/samsara-workdir": "workspace:*"
  }
}
