{
  "name": "@oldbulb/samsara",
  "version": "0.0.0",
  "private": true,
  "description": "The samsara dsh bundle: loops registry, loop providers, and the run command over dsh-base",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.1-rc.2",
    "@oldbulb/samsara-gate": "workspace:*",
    "@oldbulb/samsara-ledger": "workspace:*",
    "@oldbulb/samsara-loops": "workspace:*",
    "@oldbulb/samsara-loops-claude-code": "workspace:*",
    "@oldbulb/samsara-loops-dsh": "workspace:*",
    "@oldbulb/samsara-runner": "workspace:*",
    "@oldbulb/samsara-ui": "workspace:*"
  }
}
