{
  "name": "@oldbulb/samsara",
  "version": "0.1.0",
  "description": "The samsara dsh bundle: loops registry, loop providers, and the run command over dsh-base",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/bundle"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@oldbulb/samsara-gate": "workspace:*",
    "@oldbulb/samsara-ledger": "workspace:*",
    "@oldbulb/samsara-loops": "workspace:*",
    "@oldbulb/samsara-loops-claude-code": "workspace:*",
    "@oldbulb/samsara-loops-dsh": "workspace:*",
    "@oldbulb/samsara-runner": "workspace:*",
    "@oldbulb/samsara-ui": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.1-rc.2"
  }
}
