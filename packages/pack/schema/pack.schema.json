{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsara.dev/schema/pack.schema.json",
  "title": "samsara pack.yaml",
  "type": "object",
  "required": ["name", "truth_latency", "skill", "contract", "tasks", "commands"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "truth_latency": { "enum": ["immediate", "delayed"] },
    "skill": {
      "type": "object", "required": ["dir", "name"], "additionalProperties": false,
      "properties": { "dir": { "type": "string" }, "name": { "type": "string" } }
    },
    "contract": { "type": "string", "description": "path to the JSON schema submit_<name>.json must satisfy" },
    "tasks": {
      "type": "object", "required": ["sets", "entity_key"], "additionalProperties": false,
      "properties": {
        "sets": {
          "type": "object", "required": ["smoke", "holdin", "holdout"], "additionalProperties": false,
          "properties": { "smoke": { "type": "string" }, "holdin": { "type": "string" }, "holdout": { "type": "string" } }
        },
        "entity_key": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "stratum_key": { "type": "string" },
        "protocol": {
          "type": "object", "additionalProperties": false,
          "description": "how tasks are presented to the agent (the initial state, the rewrites of what it may see or do)",
          "properties": {
            "stage": { "type": "string" },
            "contracts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "metrics": {
      "type": "object", "required": ["primary"], "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "object", "required": ["name"], "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "unit": { "type": "string" },
            "direction": { "enum": ["up", "down"] }
          }
        },
        "cost": { "type": "string", "description": "the name of the cost metric `score` emits per task (kind: mechanical)" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "description": "what the pack's commands and the attempts execute from; undeclared, no runtime root is granted and no lock file enters env_sha",
      "properties": {
        "dirs": { "type": "array", "items": { "type": "string" }, "description": "pack-relative directories granted read-only to the sandboxed subprocess (interpreters, installed packages)" },
        "locks": { "type": "array", "items": { "type": "string" }, "description": "pack-relative globs of the files that pin those runtimes; every match is hashed into env_sha (E3)" },
        "env": { "type": "array", "items": { "type": "string" }, "description": "host environment names the pack's commands may see beside PATH, HOME, the locale, TZ, TERM and TMPDIR; every other name is withheld from truth/score/materialize (E5)" }
      }
    },
    "holdout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mde": { "type": "number", "exclusiveMinimum": 0 },
        "retention_tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "auto_demote": { "type": "boolean", "description": "a reversal or demote(...) needs a `demote` consent unless true" },
        "budget": { "type": "integer", "minimum": 1, "description": "held-out reveals the pack allows: lifecycle debits one per challenger run on the holdout set and one per settlement that re-scores a kept row's held-out attempts, replays the ledger's reveals on start, and refuses the next once spent; undeclared, reveals are not counted (holdout rotation is not implemented: architecture.md S7)" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "globs": { "type": "array", "items": { "type": "string" } },
          "config_keys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "commands": {
      "type": "object", "required": ["truth", "score"], "additionalProperties": false,
      "properties": {
        "truth": { "type": "string" },
        "score": { "type": "string" },
        "data": { "type": "string" },
        "materialize": { "type": "string" }
      }
    },
    "guards": {
      "type": "object", "additionalProperties": false,
      "properties": { "deny_patterns": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
