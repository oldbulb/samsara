{
  "name": "@oldbulb/samsara-gate",
  "version": "0.1.0",
  "description": "The verdict seam: a registry of gate policies and gate-default (paired deltas, cluster BCa bootstrap, Holm, MDE from the noise floor, futility-only early stop, cost budget, Ladder exposure)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/gate"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./default": {
      "types": "./lib/types/default.d.ts",
      "default": "./lib/default.js"
    },
    "./plugin-default": {
      "types": "./lib/types/plugin-default.d.ts",
      "default": "./lib/plugin-default.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/gate/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-kernel": "workspace:*"
  }
}
