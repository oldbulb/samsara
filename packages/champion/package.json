{
  "name": "@oldbulb/samsara-champion",
  "version": "0.1.0",
  "description": "ctx.champion: the served configuration as an alias to content-addressed refs; promote/demote rewrite the profile patch layer and verify hot-apply by re-hashing the composed config (E7)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/champion"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./state": {
      "types": "./lib/types/state.d.ts",
      "default": "./lib/state.js"
    },
    "./settlement": {
      "types": "./lib/types/settlement.d.ts",
      "default": "./lib/settlement.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/champion/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-gate": "workspace:*",
    "@oldbulb/samsara-kernel": "workspace:*",
    "@oldbulb/samsara-ledger": "workspace:*",
    "@oldbulb/samsara-signoff": "workspace:*",
    "@oldbulb/samsara-workdir": "workspace:*",
    "yaml": "2.9.0"
  }
}
