{
  "name": "@oldbulb/samsara-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The read-only /samsara page and its JSON API on ctx.webServer: champion, last settlement, challengers by tier, pending sign-offs, certification table",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/ui/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-champion": "workspace:*",
    "@oldbulb/samsara-kernel": "workspace:*",
    "@oldbulb/samsara-ledger": "workspace:*",
    "@oldbulb/samsara-signoff": "workspace:*"
  }
}
