{
  "name": "@oldbulb/samsara-loops",
  "version": "0.1.0",
  "description": "The loop-provider seam: a registry of agent loops and the AttemptSpec/LoopEvent contract every loop speaks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbulb/samsara.git",
    "directory": "packages/loops"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "samsara",
    "rsi",
    "agent-evaluation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./null": {
      "types": "./lib/types/null.d.ts",
      "default": "./lib/null.js"
    },
    "./plugin-null": {
      "types": "./lib/types/plugin-null.d.ts",
      "default": "./lib/plugin-null.js"
    },
    "./installed": {
      "types": "./lib/types/installed.d.ts",
      "default": "./lib/installed.js"
    },
    "./plugin-installed": {
      "types": "./lib/types/plugin-installed.d.ts",
      "default": "./lib/plugin-installed.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. packages/loops/tests"
  },
  "dependencies": {
    "@oldbulb/samsara-environments": "workspace:*",
    "@oldbulb/samsara-kernel": "workspace:*",
    "@oldbulb/samsara-submit": "workspace:*"
  }
}
