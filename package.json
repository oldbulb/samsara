{
  "name": "samsara-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Self-improvement substrate for agent harnesses on DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "changeset": "changeset",
    "dsh": "dsh",
    "release": "pnpm build && changeset publish",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit false --emitDeclarationOnly false",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@deepseek-ai/dsh-llm-replay": "0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
